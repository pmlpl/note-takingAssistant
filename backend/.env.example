# ========== 服务器配置（必填）==========
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://localhost:8000
# 前端地址，用于跨域配置
FRONTEND_URL=http://localhost:5174

# ========== 数据库配置（必填）==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=note_db

# ========== Redis配置（必填）==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ========== JWT配置（必填）==========
SECRET_KEY=change-me-in-production-must-be-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120  # 2小时；短有效期降低 token 泄露风险

# ========== AI配置（必填）==========
# 本地大模型：使用 LM Studio 时，在应用内开启「Local Server」后填写下面两项
# LM_STUDIO_URL 须指向 OpenAI 兼容根路径，一般为 ...:端口/v1
LM_STUDIO_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL 与 LM Studio 服务器页面显示的模型标识一致
LM_STUDIO_MODEL=your-model-id

# RAG 笔记检索使用的 embedding 模型（OpenAI 兼容 /v1/embeddings）。
# 留空则与对话模型一致；LM Studio 用户建议填实际加载的 embedding 模型，如：
# EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# 服务端默认 OpenAI 兼容 API Key（可选；LM Studio 本地常可留空）
# OPENAI_API_KEY=

# 用户自带 API Key（BYOK）在库中加密存储。
# 可选：单独 Fernet 密钥（urlsafe base64）；若留空则从 SECRET_KEY 派生，无需额外配置（更换 SECRET_KEY 会使旧密钥密文无法解密）。
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# LLM 请求超时时间（秒），本地大模型可能较慢，建议设大一些
LLM_HTTP_READ_TIMEOUT_SECONDS=1200.0

# 是否读取系统代理（HTTP_PROXY 等），本地 LM Studio 直连时设为 false
LLM_HTTP_TRUST_ENV=false

# ========== GitHub OAuth（可选）==========
# 申请地址：https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback

# ========== SMTP 邮件（可选，用于邮箱验证码登录）==========
# QQ邮箱：SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_USER=你的QQ号@qq.com
# 授权码获取：QQ邮箱设置 → 账户 → 开启POP3/SMTP服务 → 生成授权码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your_email@qq.com
# SMTP_PASSWORD=your_smtp_auth_code
# SMTP_FROM_NAME=NoteMind
