# 服务器配置
API_HOST=0.0.0.0
API_PORT=8000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=ai_note_db

# redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
SECRET_KEY=your-secret-key-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI配置（LM Studio 等 OpenAI 兼容端点）
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3.5-9b-q4_k_m_gguf
# 本地模型响应慢时加大（秒），含首 token 等待与整段生成
# LLM_HTTP_READ_TIMEOUT_SECONDS=1200