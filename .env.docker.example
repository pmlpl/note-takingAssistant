# Docker 部署专用环境变量（复制为 .env.docker 后由 docker-compose 加载）
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174

DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=note_db_password
DB_NAME=note_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

SECRET_KEY=docker-secret-key-at-least-32-chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

LM_STUDIO_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=your-model-id
OPENAI_API_KEY=

LLM_HTTP_READ_TIMEOUT_SECONDS=1200.0
LLM_HTTP_TRUST_ENV=false
