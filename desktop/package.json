{
  "name": "notemind-desktop",
  "version": "1.1.0",
  "description": "NoteMind - 智能笔记助手桌面端",
  "main": "electron/main.js",
  "author": "NoteMind Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build:renderer && npm run copy:frontend && electron .",
    "start": "electron .",
    "build:renderer": "cd renderer && npm run build",
    "copy:frontend": "node scripts/copy-frontend.js",
    "build": "npm run build:renderer && npm run copy:frontend && electron-builder",
    "build:win": "npm run build:renderer && npm run copy:frontend && electron-builder --win --x64",
    "build:mac": "npm run build:renderer && npm run copy:frontend && electron-builder --mac",
    "build:all": "npm run build:renderer && npm run copy:frontend && electron-builder --win --mac",
    "dist": "npm run build:win",
    "dist:mac": "npm run build:mac"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-icon-builder": "^2.0.1",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "svg-to-ico": "^2.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.8"
  },
  "build": {
    "appId": "com.notemind.app",
    "productName": "NoteMind",
    
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoteMind",
      "unicode": true,
      "warningsAsErrors": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
