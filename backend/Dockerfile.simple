# ==============================================================
#  后端 Dockerfile（简化版）
#  基于本地 alpine:latest + apk 安装 Python 3.12
#  避免从 Docker Hub 拉取 python 镜像（国内网络问题）
# ==============================================================

FROM alpine:latest

WORKDIR /app

# 使用清华镜像加速 apk 下载，安装 Python 3 + 编译依赖
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories \
    && apk add --no-cache \
    python3 \
    py3-pip \
    gcc \
    musl-dev \
    python3-dev \
    libffi-dev \
    openssl-dev \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && pip3 install --no-cache-dir --break-system-packages --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple

# 先复制依赖文件，利用 Docker 缓存层
COPY requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple \
    && pip install --no-cache-dir --break-system-packages httpx -i https://pypi.tuna.tsinghua.edu.cn/simple

# 复制后端代码
COPY . .

# 创建上传目录
RUN mkdir -p uploads

# 创建空 .env 文件，避免 pydantic-settings 找不到 env_file 报错
RUN touch /.env

EXPOSE 8000

# 单 worker 启动（lifespan 自动执行 Base.metadata.create_all 建表）
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
