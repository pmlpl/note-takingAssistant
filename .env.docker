# ==============================================================
#  生产环境变量（必须改成你自己的值！不要保留默认值！）
#
#  使用方法：
#    1) cp .env.docker .env
#    2) 修改下面 3 个密钥为随机长字符串
#    3) docker compose up -d --build
#
#  生成随机密钥可以用：
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
#  或直接在 Linux 上运行：openssl rand -base64 48
# ==============================================================

# -------- 数据库密码（至少 16 位，字母+数字+特殊符号）--------
DB_PASSWORD=ChangeThisToALongRandomString123!
DB_NAME=note_db

# -------- Redis 密码（新增强）--------
REDIS_PASSWORD=ChangeThisToAnotherLongRandomString456!

# -------- JWT 密钥（必须 ≥ 32 个字符）--------
SECRET_KEY=ChangeThisToAVeryLongRandomStringForJWTsigning789!
