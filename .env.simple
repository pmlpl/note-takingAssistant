# ==============================================================
#  NoteMind 一键部署环境变量（简化版）
#  复制为 .env 后使用：copy .env.simple .env
# ==============================================================

# -------- 外部访问端口（浏览器访问的端口）--------
EXTERNAL_PORT=8090

# -------- 数据库配置 --------
DB_PASSWORD=notemind_db_secure_pass_2024
DB_NAME=ai_note_db

# -------- Redis 密码 --------
REDIS_PASSWORD=notemind_redis_secure_pass_2024

# -------- JWT 密钥（≥32 字符）--------
SECRET_KEY=notemind_jwt_secret_key_please_change_in_production_2024
